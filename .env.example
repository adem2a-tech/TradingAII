AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Vercel (Settings → Environment Variables) — recommandé en prod :
# AUTH_SECRET=< openssl rand -base64 32 >
# AUTH_URL=https://trading-iaa.vercel.app
# NEXTAUTH_URL=https://trading-iaa.vercel.app
# NEXT_PUBLIC_APP_URL=https://trading-iaa.vercel.app

# Stripe — obligatoire pour les paiements Pro (local ET Vercel Production)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL publique du site (success/cancel Stripe Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel Production (Settings → Environment Variables) ──
# Copie les mêmes clés Stripe + mets l’URL de prod :
# NEXT_PUBLIC_APP_URL=https://trading-iaa.vercel.app
# AUTH_URL=https://trading-iaa.vercel.app
# NEXTAUTH_URL=https://trading-iaa.vercel.app
# AUTH_SECRET=< openssl rand -base64 32 >
#
# Webhook Stripe (Developers → Webhooks → Add endpoint) :
# URL : https://trading-iaa.vercel.app/api/stripe/webhook
# Events : checkout.session.completed
# → copie STRIPE_WEBHOOK_SECRET (whsec_...) dans Vercel
